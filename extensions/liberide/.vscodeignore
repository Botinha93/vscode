# esbuild bundles every runtime dependency (including the symlinked
# @nexus/shared) into extension.js and media/*.js, so sources, tooling and
# node_modules stay out of the packaged built-in extension.
src/**
test/**
node_modules/**
esbuild.mjs
verify-build-reproducible.mjs
tsconfig.json
bun.lock
package-lock.json
**/*.map
