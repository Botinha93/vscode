{
  "name": "liberide",
  "displayName": "LiberIDE",
  "description": "LiberIDE chat, pipeline, and spec workflow integration for the bundled VS Code workspace.",
  "version": "0.3.0",
  "publisher": "nexus",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["AI", "Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "bun test src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "LiberIDE",
      "properties": {
        "liberide.modelSelection": {
          "type": "string",
          "enum": ["auto", "manual"],
          "default": "manual",
          "description": "Local override for model selection mode. When 'auto', the backend may upgrade the model based on the request. Configure models in the VoxChat app."
        },
        "liberide.useRag": {
          "type": "boolean",
          "default": false,
          "description": "Local default for RAG on new chats. Can be overridden per chat."
        },
        "liberide.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional local system prompt appended to every LiberIDE chat request."
        },
        "liberide.copilot.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Re-enable the bundled Copilot extension UI surfaces. Recommended to keep disabled while using LiberIDE's UI."
        },
        "liberide.copilot.modelsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Copilot model access via VS Code's Language Model API (vscode.lm). Requires the Copilot model provider to be available."
        },
        "liberide.defaultAllowedAgentIds": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Default agents the model may spawn via the agent tool for new LiberIDE chats. Empty means all callable agents. Per-conversation values sync with VoxChat."
        },
        "liberide.swarm": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, Dispatch Feature runs the swarm execution graph: independent, non-blocking tasks are implemented in parallel and hard blockers gate the run for approval."
        },
        "liberide.isolation": {
          "type": "string",
          "enum": ["shared", "worktree"],
          "enumDescriptions": [
            "All parallel branches edit the same working tree.",
            "Each parallel branch runs in its own git worktree, merged when the branch join completes."
          ],
          "default": "shared",
          "description": "Isolation strategy for parallel implementation branches when swarm is enabled."
        },
        "liberide.confirmEdits": {
          "type": "string",
          "enum": ["off", "always", "multiFileAndDeletes"],
          "enumDescriptions": [
            "Apply agent edits directly without a preview.",
            "Open VS Code's refactor-preview (diff + per-change checkboxes) for every agent edit.",
            "Preview only multi-file edits and file creates/renames/deletes; apply single-file text edits directly."
          ],
          "default": "off",
          "description": "Whether agent file edits open VS Code's refactor-preview for confirmation before applying."
        },
        "liberide.dispatch.skipPreview": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, Dispatch Feature queues immediately without showing the plan-preview confirmation (task list with deselect/confirm/cancel)."
        }
      }
    },
    "commands": [
      {
        "command": "liberide.openChat",
        "title": "Open LiberIDE Chat",
        "category": "LiberIDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "liberide.newChat",
        "title": "New Chat",
        "category": "LiberIDE",
        "icon": "$(add)"
      },
      {
        "command": "liberide.attachSelection",
        "title": "Attach Selection to LiberIDE Chat",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.attachActiveFile",
        "title": "Attach Active File to LiberIDE Chat",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.attachFileToChat",
        "title": "Attach File to LiberIDE Chat (@file)",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.attachTerminalOutput",
        "title": "Attach Terminal Output to LiberIDE Chat",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.attachGitDiff",
        "title": "Attach Git Diff to LiberIDE Chat",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.openSettings",
        "title": "Open LiberIDE Settings",
        "category": "LiberIDE",
        "icon": "$(gear)"
      },
      {
        "command": "liberide.openChatHistory",
        "title": "Show Chat History",
        "category": "LiberIDE",
        "icon": "$(history)"
      },
      {
        "command": "liberide.renameChat",
        "title": "Rename Current Chat",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.openPipeline",
        "title": "Open LiberIDE Pipeline",
        "category": "LiberIDE",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "liberide.scaffoldFeature",
        "title": "Scaffold Spec Feature",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.setActiveFeature",
        "title": "Set Active Spec Feature",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.openTask",
        "title": "Open Task Contract",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.runTask",
        "title": "Run Task",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.markTaskReady",
        "title": "Mark Task Ready",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.dispatchFeature",
        "title": "Dispatch Feature Tasks",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.regenerateTasksIndex",
        "title": "Regenerate Tasks Index",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.cancelRun",
        "title": "Cancel Active Run",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.resolveApproval",
        "title": "Resolve Approval",
        "category": "LiberIDE",
        "icon": "$(person)"
      },
      {
        "command": "liberide.retryRun",
        "title": "Retry Run",
        "category": "LiberIDE",
        "icon": "$(refresh)"
      },
      {
        "command": "liberide.replayFromNode",
        "title": "Replay From Node",
        "category": "LiberIDE",
        "icon": "$(debug-restart)"
      },
      {
        "command": "liberide.showNodeDetail",
        "title": "Show Node Detail",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.viewArtifacts",
        "title": "View Artifacts",
        "category": "LiberIDE",
        "icon": "$(file-code)"
      },
      {
        "command": "liberide.viewWorkingMemory",
        "title": "View Working Memory",
        "category": "LiberIDE",
        "icon": "$(database)"
      },
      {
        "command": "liberide.addWorkingMemoryNote",
        "title": "Add Context to Working Memory",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.addFollowUp",
        "title": "Add Follow-up Goal",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.viewRunCost",
        "title": "View Run Cost",
        "category": "LiberIDE",
        "icon": "$(graph)"
      },
      {
        "command": "liberide.refreshSpecs",
        "title": "Refresh Specs",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.refreshTasks",
        "title": "Refresh Tasks",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.refreshRuns",
        "title": "Refresh Runs",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.refreshApprovals",
        "title": "Refresh Approvals",
        "category": "LiberIDE",
        "icon": "$(refresh)"
      },
      {
        "command": "liberide.revokeApprovalGrant",
        "title": "Revoke Grant",
        "category": "LiberIDE",
        "icon": "$(trash)"
      },
      {
        "command": "liberide.selectActiveProject",
        "title": "Select Active Project",
        "category": "LiberIDE"
      },
      {
        "command": "liberide.refreshMcpServers",
        "title": "Refresh MCP Servers",
        "category": "LiberIDE",
        "icon": "$(refresh)"
      },
      {
        "command": "liberide.enableMcpServer",
        "title": "Enable MCP Server",
        "category": "LiberIDE",
        "icon": "$(plug)"
      },
      {
        "command": "liberide.disableMcpServer",
        "title": "Disable MCP Server",
        "category": "LiberIDE",
        "icon": "$(circle-slash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liberide",
          "title": "LiberIDE",
          "icon": "resources/liberide.svg"
        },
        {
          "id": "liberide-pipeline",
          "title": "LiberIDE Pipeline",
          "icon": "resources/liberide-pipeline.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "liberide-chat",
          "title": "LiberIDE",
          "icon": "resources/liberide.svg"
        }
      ]
    },
    "views": {
      "liberide-chat": [
        {
          "type": "webview",
          "id": "liberide.chat",
          "name": "Chat",
          "icon": "resources/liberide.svg",
          "contextualTitle": "LiberIDE"
        }
      ],
      "liberide-pipeline": [
        {
          "type": "webview",
          "id": "liberide.pipeline",
          "name": "Pipeline",
          "icon": "resources/liberide-pipeline.svg",
          "contextualTitle": "LiberIDE Pipeline"
        }
      ],
      "liberide": [
        {
          "id": "liberide.specs",
          "name": "Specs"
        },
        {
          "id": "liberide.tasks",
          "name": "Tasks"
        },
        {
          "id": "liberide.runs",
          "name": "Agent Runs"
        },
        {
          "id": "liberide.approvals",
          "name": "Approvals & Permissions"
        },
        {
          "id": "liberide.mcp",
          "name": "MCP Servers"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "liberide.openChat"
        },
        {
          "command": "liberide.newChat"
        },
        {
          "command": "liberide.openSettings"
        },
        {
          "command": "liberide.openChatHistory"
        },
        {
          "command": "liberide.renameChat"
        },
        {
          "command": "liberide.openPipeline"
        },
        {
          "command": "liberide.scaffoldFeature"
        },
        {
          "command": "liberide.dispatchFeature"
        },
        {
          "command": "liberide.attachSelection"
        },
        {
          "command": "liberide.attachActiveFile"
        },
        {
          "command": "liberide.attachFileToChat"
        },
        {
          "command": "liberide.attachTerminalOutput"
        },
        {
          "command": "liberide.attachGitDiff"
        }
      ],
      "editor/context": [
        {
          "command": "liberide.attachSelection",
          "when": "editorHasSelection",
          "group": "liberide@1"
        }
      ],
      "view/title": [
        {
          "command": "liberide.newChat",
          "when": "view == liberide.chat",
          "group": "navigation@1"
        },
        {
          "command": "liberide.openChatHistory",
          "when": "view == liberide.chat",
          "group": "navigation@2"
        },
        {
          "command": "liberide.openPipeline",
          "when": "view == liberide.chat",
          "group": "navigation@3"
        },
        {
          "command": "liberide.openSettings",
          "when": "view == liberide.chat",
          "group": "navigation@4"
        },
        {
          "command": "liberide.renameChat",
          "when": "view == liberide.chat",
          "group": "1_modify"
        },
        {
          "command": "liberide.refreshSpecs",
          "when": "view == liberide.specs",
          "group": "navigation"
        },
        {
          "command": "liberide.scaffoldFeature",
          "when": "view == liberide.specs",
          "group": "navigation"
        },
        {
          "command": "liberide.refreshTasks",
          "when": "view == liberide.tasks",
          "group": "navigation"
        },
        {
          "command": "liberide.dispatchFeature",
          "when": "view == liberide.tasks",
          "group": "navigation"
        },
        {
          "command": "liberide.refreshRuns",
          "when": "view == liberide.runs",
          "group": "navigation"
        },
        {
          "command": "liberide.refreshApprovals",
          "when": "view == liberide.approvals",
          "group": "navigation"
        },
        {
          "command": "liberide.refreshMcpServers",
          "when": "view == liberide.mcp",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "liberide.openTask",
          "when": "view == liberide.tasks && viewItem == task",
          "group": "navigation"
        },
        {
          "command": "liberide.runTask",
          "when": "view == liberide.tasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "liberide.markTaskReady",
          "when": "view == liberide.tasks && viewItem == task",
          "group": "inline"
        },
        {
          "command": "liberide.setActiveFeature",
          "when": "view == liberide.specs && viewItem == feature",
          "group": "inline"
        },
        {
          "command": "liberide.cancelRun",
          "when": "view == liberide.runs && viewItem == run",
          "group": "inline"
        },
        {
          "command": "liberide.resolveApproval",
          "when": "view == liberide.runs && viewItem == run-waiting",
          "group": "inline"
        },
        {
          "command": "liberide.cancelRun",
          "when": "view == liberide.runs && viewItem == run-waiting",
          "group": "inline"
        },
        {
          "command": "liberide.retryRun",
          "when": "view == liberide.runs && viewItem == run-terminal",
          "group": "inline"
        },
        {
          "command": "liberide.replayFromNode",
          "when": "view == liberide.runs && viewItem == node",
          "group": "inline"
        },
        {
          "command": "liberide.viewArtifacts",
          "when": "view == liberide.runs && viewItem == run-terminal",
          "group": "inline"
        },
        {
          "command": "liberide.viewArtifacts",
          "when": "view == liberide.runs && viewItem == run",
          "group": "inline"
        },
        {
          "command": "liberide.viewWorkingMemory",
          "when": "view == liberide.runs && viewItem =~ /^run/",
          "group": "inspect@1"
        },
        {
          "command": "liberide.addWorkingMemoryNote",
          "when": "view == liberide.runs && viewItem =~ /^run/",
          "group": "inspect@2"
        },
        {
          "command": "liberide.addFollowUp",
          "when": "view == liberide.runs && viewItem == run-terminal",
          "group": "inspect@3"
        },
        {
          "command": "liberide.viewRunCost",
          "when": "view == liberide.runs && viewItem =~ /^run/",
          "group": "inspect@4"
        },
        {
          "command": "liberide.revokeApprovalGrant",
          "when": "view == liberide.approvals && viewItem == approval-grant-active",
          "group": "inline"
        },
        {
          "command": "liberide.enableMcpServer",
          "when": "view == liberide.mcp && viewItem == mcp-server-disabled",
          "group": "inline"
        },
        {
          "command": "liberide.disableMcpServer",
          "when": "view == liberide.mcp && viewItem == mcp-server-enabled",
          "group": "inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "liberide.specs",
        "contents": "No spec features yet.\n[Scaffold a feature](command:liberide.scaffoldFeature)"
      },
      {
        "view": "liberide.tasks",
        "contents": "Select a feature in the Specs view to inspect and dispatch its tasks."
      },
      {
        "view": "liberide.runs",
        "contents": "Dispatched feature and task runs appear here.\n[Open Pipeline](command:liberide.openPipeline)"
      }
    ]
  },
  "dependencies": {
    "@nexus/shared": "file:../../../packages/shared",
    "cytoscape": "^3.30.0",
    "cytoscape-dagre": "^2.5.0",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/cytoscape": "^3.21.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
